# Environment: "development" = HTTP on port 3000 with insecure dev defaults.
# Any other value is production.
NODE_ENV=development
PORT=3000
# Interface to listen on (default: all). 127.0.0.1 keeps the HTTP port off
# the network when a local proxy (e.g. `tailscale serve`) handles HTTPS.
# HOST=127.0.0.1

# With Docker, NODE_ENV, PORT, HOST, KONTO_DATA_DIR and TRUST_PROXY are set by
# docker-compose.yml and the values in this file are ignored.

# Seed user, created only when the database has no users (first start).
KONTO_USER=admin
KONTO_PASS=change-this-password

# Session signing key: use a long random value, e.g. `openssl rand -hex 32`.
# Required in production.
SESSION_SECRET=change-this-secret

# Session lifetime in days (renewed on every request).
SESSION_MAX_AGE_DAYS=30

# HTTPS certificate and key (production only, optional).
# SSL_CERT_PATH=/path/to/certificate.crt
# SSL_KEY_PATH=/path/to/private.key

# Self-service sign-up from the login page (default: disabled).
# Enable it only if everyone who can reach the URL may create an account.
# REGISTRATION_ENABLED=true

# Only behind a reverse proxy that terminates TLS (nginx, Caddy, tailscale
# serve...): number of trusted hops, "loopback", or a list of IPs/subnets.
# TRUST_PROXY=loopback

# Data directory (default: backend/data).
# KONTO_DATA_DIR=/var/lib/konto

# Language of the seed user's default categories and account: "en" or "it"
# (default: en). Users who sign up later get them in their browser language.
# KONTO_LOCALE=en

# Currency of the instance, as an ISO 4217 code (default: EUR).
# KONTO_CURRENCY=EUR
